# Windup Monitor Core — local development environment.
# Copy to core/.env (gitignored). Never commit real secrets.

# PostgreSQL connection (matches scripts/dev-db.sh defaults).
DATABASE_URL=postgresql://statuspilot:statuspilot@127.0.0.1:55432/statuspilot?schema=public

# Required in production: >= 32 random bytes, e.g. `openssl rand -base64 48`.
# In development an ephemeral secret is generated when omitted (sessions do not
# survive a restart).
SESSION_SECRET=

NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Session cookie: Secure is forced on in production. Keep false only for
# plain-HTTP local development; the cookie falls back to `sp_session` because
# the __Host- prefix requires Secure.
COOKIE_SECURE=false

# Trust X-Forwarded-* headers (enable only behind a reverse proxy you control).
TRUST_PROXY=false

# Comma-separated extra allowed origins for mutating requests. Same-origin
# requests (Origin host == Host header) are always accepted.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap token: one-time, written with mode 0600. Never logged by default.
BOOTSTRAP_TOKEN_FILE=data/bootstrap-token
BOOTSTRAP_TOKEN_TTL_MINUTES=30
BOOTSTRAP_TOKEN_STDOUT=false

# Agent pairing token TTL.
ENROLL_TOKEN_TTL_MINUTES=15

# Agent liveness thresholds (docs DEC-003).
AGENT_HEARTBEAT_INTERVAL_S=15
AGENT_STALE_SECONDS=45
AGENT_OFFLINE_SECONDS=300

# Raw samples older than this are flagged late (not rejected).
LATE_SAMPLE_SECONDS=600

# Rate limits.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=5
BOOTSTRAP_RATE_LIMIT=10
BOOTSTRAP_RATE_WINDOW_MINUTES=10
ENROLL_RATE_LIMIT=10
ENROLL_RATE_WINDOW_MINUTES=10
ROTATE_DAILY_LIMIT=5

LOG_LEVEL=info

# Directory with the built SPA (relative to core/ by default).
WEB_DIST_DIR=../web/dist

# --- AI (docs/ai-integration-contract.md) ------------------------------------
# AES-256-GCM key for stored provider secrets (separate from SESSION_SECRET).
# 32-byte base64/hex or a long passphrase. When empty: AI settings stay
# readable, but saving any credential fails with AI_CREDENTIAL_KEY_MISSING.
# Example: openssl rand -base64 48
AI_CREDENTIAL_KEY=

# ChatGPT (Sign-in with ChatGPT, docs/chatgpt-setup.md). The loopback
# redirect path is fixed by the SIWC registration: only the port may vary.
AI_CHATGPT_ENABLED=true
AI_CHATGPT_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
# Stable opaque host id, generated once per host (never an e-mail/user id):
#   node -e "console.log('urn:uuid:' + require('node:crypto').randomUUID())"
AI_CHATGPT_HOST_ID=

# Connection-check targets (defaults: official endpoints; override only for
# tests or self-hosted gateways) and outbound timeout.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_BASE_URL=https://api.openai.com/v1
#AI_REQUEST_TIMEOUT_MS=10000
