# Windup Monitor deployment environment (Compose).
# Copy to deploy/.env and fill in real secrets. Never commit this file.

# PostgreSQL credentials (required).
POSTGRES_USER=statuspilot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=statuspilot

# Required: session/CSRF signing secret, >= 32 bytes.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# Publish Core on the host. Loopback by default; use the TLS proxy for remote access.
CORE_PORT=8080

# Keep true when served over HTTPS (production/Caddy). Set false only for a
# plain-HTTP test on a trusted loopback.
COOKIE_SECURE=true

# Enable only behind a reverse proxy you control.
TRUST_PROXY=true

# Optional extra allowed origins for mutating requests (comma-separated).
# Same-origin requests are always accepted.
ALLOWED_ORIGINS=

# Optional: AES-256-GCM key for stored AI provider secrets (AI settings stay
# readable without it; saving a credential fails with AI_CREDENTIAL_KEY_MISSING).
# Generate with: openssl rand -base64 48
AI_CREDENTIAL_KEY=

# TLS profile: domain Caddy should obtain a certificate for.
SP_DOMAIN=status.example.com

LOG_LEVEL=info
