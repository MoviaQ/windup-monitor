# Caddyfile for the optional TLS profile (deploy/docker-compose.tls.yml).
# Caddy terminates TLS and proxies to the Core container on the compose network.
{$SP_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy core:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format console
	}
}
